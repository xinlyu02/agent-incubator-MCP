# Local development — set AUTH_MODE=mock to skip XSUAA token exchange
PORT=3000
AUTH_MODE=mock
MOCK_USER_EMAIL=user@example.com
INCUBATOR_BASE_URL=http://localhost:3001

# CF deployment — same BTP subaccount (recommended, no XSUAA credentials needed)
# AUTH_MODE=passthrough
# INCUBATOR_BASE_URL=https://<incubator-cf-app>.cfapps.<region>.hana.ondemand.com

# CF deployment — cross-subaccount (requires XSUAA service binding)
# AUTH_MODE=xsuaa
# XSUAA_URL=https://<subdomain>.authentication.<region>.hana.ondemand.com
# XSUAA_CLIENT_ID=sb-incubator-mcp!t12345
# XSUAA_CLIENT_SECRET=<secret>
# INCUBATOR_BASE_URL=https://<incubator-cf-app>.cfapps.<region>.hana.ondemand.com